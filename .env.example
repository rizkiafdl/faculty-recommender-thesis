# Copy this file to .env and adjust values as needed.
# CPU-friendly defaults:
DATABASE_URL=sqlite:////app/data/recommendation.db
DEFAULT_EXCEL_PATH=/app/mapping faculty supervisor.xlsx
DEFAULT_SHEET_NAME=Sheet1
EMBEDDING_MODEL_NAME=answerdotai/ModernBERT-base
EMBEDDING_FALLBACK_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DEVICE=auto
BENCHMARK_MODEL_NAMES=answerdotai/ModernBERT-base,sentence-transformers/all-mpnet-base-v2,sentence-transformers/all-MiniLM-L6-v2
FLASK_SECRET_KEY=changeme

# If you have NVIDIA GPU in Docker, switch:
# EMBEDDING_DEVICE=cuda
