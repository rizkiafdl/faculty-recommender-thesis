# Copy this file to .env and adjust values as needed.
# CPU-friendly defaults:
# DATABASE_URL — optional. Auto-detected relative to project root if omitted.
# Local dev: leave unset (config.py resolves it automatically).
# Docker:     DATABASE_URL=sqlite:////app/data/recommendation.db
# DEFAULT_EXCEL_PATH — optional. Same auto-detection rule.
# Docker:     DEFAULT_EXCEL_PATH=/app/mapping faculty supervisor.xlsx
DEFAULT_SHEET_NAME=Sheet1
EMBEDDING_DEVICE=auto
FLASK_SECRET_KEY=changeme

# If you have NVIDIA GPU in Docker, switch:
# EMBEDDING_DEVICE=cuda
